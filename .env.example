# Copie para ".env" e ajuste. Só variáveis EXPO_PUBLIC_* chegam ao app.
# Sem esta variável o app usa localhost (iOS/web) ou 10.0.2.2 (emulador Android), porta 8080.

# Backend publicado (termine com /api, sem barra no final):
EXPO_PUBLIC_API_URL=https://COLE-AQUI-O-ENDERECO-DO-BACKEND/api

# Celular físico com backend rodando no seu PC (use o IP da sua máquina na Wi-Fi):
# EXPO_PUBLIC_API_URL=http://192.168.0.10:8080/api
