{
  "expo": {
    "name": "PetCareIA+",
    "slug": "petcare-mobile",
    "scheme": "petcareia",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "splash": {
      "backgroundColor": "#1a5fb4"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "br.com.petcare.mobile"
    },
    "android": {
      "package": "br.com.petcare.mobile",
      "usesCleartextTraffic": true
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "color": "#1a5fb4"
        }
      ]
    ]
  }
}
