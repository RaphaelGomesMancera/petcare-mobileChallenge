{
  "expo": {
    "name": "PetCareIA+",
    "slug": "petcare-mobile",
    "scheme": "petcareia",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/logo.png",
    "splash": {
      "image": "./assets/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#eef6f4"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "br.com.petcare.mobile"
    },
    "android": {
      "package": "br.com.petcare.mobile",
      "usesCleartextTraffic": true
    },
    "web": {
      "favicon": "./assets/logo.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "color": "#0b5cad"
        }
      ]
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "7ff2aa53-611c-454d-b27e-15d915e31bb5"
      }
    },
    "owner": "raphaelmancera010"
  }
}
